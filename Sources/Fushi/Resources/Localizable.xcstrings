    "Keyboard locking fails after updating Fushi?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Falla el bloqueo del teclado tras actualizar Fushi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fushi をアップデートしたらキーボードをロックできなくなりましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
