    "Click Start Cleaning (or press Return). Locking begins after a 3-second countdown; click Cancel or press Esc during the countdown to stop.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Iniciar limpieza (o pulsa Retorno). El bloqueo empieza tras una cuenta atrás de 3 segundos; durante la cuenta atrás, haz clic en Cancelar o pulsa Esc para detenerla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「清掃を開始」をクリック (または Return キー) すると、3 秒のカウントダウン後にロックされます。カウントダウン中は「キャンセル」または Esc で中止できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘청소 시작’을 클릭(또는 Return)하면 3초 카운트다운 후 잠깁니다. 카운트다운 중에는 ‘취소’나 Esc로 멈출 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下方的“开始清洁”(或按 Return)，倒计时 3 秒后开始锁定；倒计时中可以按“取消”或 Esc。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下方的「開始清潔」(或按 Return)，倒數 3 秒後開始鎖定；倒數中可以按「取消」或 Esc。"
          }
        }
      }
    },
    "Connect a mouse to start": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta un ratón para empezar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
