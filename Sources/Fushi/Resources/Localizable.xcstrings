    "Can’t find it, or turning it on has no effect?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo encuentras o activarlo no hace nada?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つからない、またはオンにしても反応しない場合"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찾을 수 없거나 켜도 반응이 없나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到或打开了没反应？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到或勾了沒反應？"
          }
        }
      }
    },
    "Can’t start": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede empezar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작할 수 없음"
          }
        },
        "zh-Hans": {
