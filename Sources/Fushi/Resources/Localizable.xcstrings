    "Sometimes an app must be reopened before a new permission takes effect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A veces hay que volver a abrir una app para que un permiso nuevo surta efecto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい権限を反映するには アプリ を開き直す必要がある場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 권한을 적용하려면 앱을 다시 열어야 할 때가 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统有时要重新打开 App，新权限才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統有時要重新打開 App，新權限才會生效。"
          }
