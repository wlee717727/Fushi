    "Hold Esc for 3 s to end · or move the external mouse": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada Esc 3 s para terminar · o mueve el ratón externo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc を 3 秒押して終了 · または外付けマウスを動かす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc를 3초 눌러 종료 · 또는 외장 마우스를 움직이기"
          }
        },
        "zh-Hans": {
