      }
    },
    "Esc": {
      "shouldTranslate": false
    },
    "Every display turns black. With OLED the pixels go dark, so dust and fingerprints are easiest to see.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las pantallas se vuelven negras. En OLED los píxeles se apagan, así que el polvo y las huellas se ven mejor que nunca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのディスプレイが真っ黒になります。OLED は発光しないので、ほこりや指紋がいちばん見やすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 디스플레이가 검게 바뀝니다. OLED는 빛을 내지 않아 먼지와 지문이 가장 잘 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有屏幕变成全黑，OLED 不发光，最容易看出灰尘与指纹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有螢幕變成全黑，OLED 不發光，最容易看出灰塵與指紋。"
          }
        }
      }
    },
    "Every key is paused.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las teclas quedan en pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのキーを一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 키가 일시 정지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有按键暂时失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有按鍵暫停作用。"
          }
        }
      }
    },
    "Everything locked": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo bloqueado"
