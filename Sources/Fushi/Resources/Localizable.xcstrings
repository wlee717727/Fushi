    "Hold for %lld seconds": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado %lld segundos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒押し続ける"
